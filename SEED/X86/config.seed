### TARGET ###
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

### IMAGE ###
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=4096
CONFIG_GRUB_TIMEOUT="0"

### BUILD ###
CONFIG_TOOLCHAINOPTS=y
CONFIG_ZLIB_OPTIMIZE_SPEED=y

# 关闭开发调试
# CONFIG_ALL_KMODS is not set
# CONFIG_DEVEL is not set
# CONFIG_KERNEL_WERROR is not set
# CONFIG_COLLECT_KERNEL_DEBUG is not set
# CONFIG_REPRODUCIBLE_DEBUG_INFO is not set

CONFIG_KERNEL_BUILD_DOMAIN="buildhost"
CONFIG_KERNEL_BUILD_USER="builder"

### BASE ###
CONFIG_PACKAGE_autocore-x86=y
CONFIG_PACKAGE_addition-trans-zh=y

CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_irqbalance=y

### FILESYSTEM ###
CONFIG_PACKAGE_kmod-fs-f2fs=y

### NETWORK DRIVER ###
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-igb-intel=y
CONFIG_PACKAGE_kmod-i40e=y
CONFIG_PACKAGE_kmod-iavf=y
CONFIG_PACKAGE_kmod-ixgbevf=y
CONFIG_PACKAGE_kmod-mlx4-core=y
CONFIG_PACKAGE_kmod-mlx5-core=y

# 删除核显驱动
# CONFIG_PACKAGE_kmod-drm-i915 is not set
# CONFIG_PACKAGE_i915-firmware-dmc is not set

### DNS ###
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y

# 不使用旧 dnsmasq
# CONFIG_PACKAGE_dnsmasq is not set

### FIREWALL ###
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y

# flow offload
CONFIG_PACKAGE_kmod-nft-offload=y

# fullcone
CONFIG_PACKAGE_kmod-nft-fullcone=y

### IPTABLES NFT ###
CONFIG_PACKAGE_arptables-nft=y
CONFIG_PACKAGE_ebtables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_xtables-nft=y

CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-iprange=y
CONFIG_PACKAGE_iptables-mod-nat-extra=y
CONFIG_PACKAGE_iptables-mod-socket=y
CONFIG_PACKAGE_iptables-mod-tproxy=y

### 删除 legacy ###
# CONFIG_PACKAGE_firewall is not set
# CONFIG_PACKAGE_arptables-legacy is not set
# CONFIG_PACKAGE_ebtables-legacy is not set
# CONFIG_PACKAGE_ip6tables-legacy is not set
# CONFIG_PACKAGE_xtables-legacy is not set
# CONFIG_PACKAGE_iptables-legacy is not set

### NAT ###
CONFIG_PACKAGE_nat6=y
CONFIG_PACKAGE_miniupnpd-nftables=y

### LUCI ###
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_en=y

CONFIG_PACKAGE_luci-nginx=y

# 不压缩 JS/CSS
# CONFIG_LUCI_CSSTIDY is not set
# CONFIG_LUCI_JSMIN is not set

### NIKKI ###
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

### MOSDNS ###
CONFIG_PACKAGE_luci-app-mosdns=y

### OAF ###
CONFIG_PACKAGE_luci-app-oaf=y

### VPN ###
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_qrencode=y

### DDNS ###
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_ddns-scripts-services=y
CONFIG_PACKAGE_bind-host=y

### OPENSSL ###
CONFIG_OPENSSL_ENGINE=y
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
CONFIG_OPENSSL_WITH_ASM=y

# 删除 legacy
# CONFIG_PACKAGE_libopenssl-legacy is not set

CONFIG_PACKAGE_libopenssl-conf=y
CONFIG_PACKAGE_libopenssl-devcrypto=y

### CURL ###
CONFIG_PACKAGE_libcurl=y
CONFIG_LIBCURL_OPENSSL=y

# 禁用其他 SSL 后端
# CONFIG_LIBCURL_MBEDTLS is not set
# CONFIG_LIBCURL_WOLFSSL is not set
# CONFIG_LIBCURL_GNUTLS is not set
# CONFIG_LIBCURL_NOSSL is not set

### CRYPTO ###
CONFIG_PACKAGE_kmod-crypto-aead=y
CONFIG_PACKAGE_kmod-crypto-authenc=y
CONFIG_PACKAGE_kmod-crypto-gcm=y
CONFIG_PACKAGE_kmod-crypto-ghash=y

CONFIG_PACKAGE_kmod-crypto-chacha20poly1305=y
CONFIG_PACKAGE_kmod-crypto-lib-chacha20=y
CONFIG_PACKAGE_kmod-crypto-lib-chacha20poly1305=y
CONFIG_PACKAGE_kmod-crypto-lib-poly1305=y
CONFIG_PACKAGE_kmod-crypto-lib-curve25519=y

CONFIG_PACKAGE_kmod-crypto-hmac=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-crypto-sha512=y
CONFIG_PACKAGE_kmod-crypto-rng=y
CONFIG_PACKAGE_kmod-crypto-seqiv=y

### BBR ###
CONFIG_DEFAULT_tcp_congestion="bbr"
CONFIG_PACKAGE_kmod-tcp-bbr=y

### RNG ###
CONFIG_PACKAGE_urngd=y

### REMOVE ###
# 删除全部冲突代理

# CONFIG_PACKAGE_luci-app-dae is not set
# CONFIG_PACKAGE_dae is not set

# CONFIG_PACKAGE_luci-app-passwall is not set

# CONFIG_PACKAGE_luci-app-openclash is not set

# CONFIG_PACKAGE_luci-app-ssr-plus is not set

# CONFIG_PACKAGE_luci-app-homeproxy is not set

# CONFIG_PACKAGE_luci-app-bypass is not set

# 删除 SFE
# CONFIG_PACKAGE_kmod-shortcut-fe-cm is not set
# CONFIG_PACKAGE_kmod-fast-classifier is not set
